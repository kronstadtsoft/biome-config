{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "root": true,
  "plugins": [{ "path": "../../no-cast.grit", "includes": ["**/*.ts", "!**/env.ts"] }],
  "vcs": { "enabled": false },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": { "preset": "none" }
  }
}

{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  // The root configuration is the published base, so the gate's exemptions live here.
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "correctness": {
        "noNodejsModules": "off"
      },
      "suspicious": {
        "noConsole": "off"
      }
    }
  }
}

{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/.react-router",
      "!**/.open-next",
      "!**/.next",
      "!**/build",
      "!**/dist",
      "!**/worker-configuration.d.ts",
      "!**/cloudflare-env.d.ts",
      // Vendored rule files keep their exact bytes; a rewrite reads as drift.
      "!**/.claude",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    },
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    // A rule turned off here is off in every repository that extends this file.
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "all"
      },
      "complexity": {
        "preset": "recommended",
        // At odds with `noPropertyAccessFromIndexSignature`, which every tsconfig here turns on:
        // it requires the bracket notation that Biome would rewrite away.
        "useLiteralKeys": "off"
      },
      "nursery": {
        "preset": "none"
      },
      "correctness": {
        "preset": "all",
        // Everything is bundled, so extensionless and virtual specifiers are normal.
        "useImportExtensions": "off",
        "noUnresolvedImports": "off",
        // Solid and Qwik rules; every project here uses React.
        "noSolidDestructuredProps": "off",
        "useQwikValidLexicalScope": "off"
      },
      "style": {
        "preset": "all",
        // Too noisy for UI code and generated names.
        "noJsxLiterals": "off",
        "noMagicNumbers": "off",
        "noTernary": "off",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "preset": "all",
        // Solid rule (`class` and `for` over `className` and `htmlFor`).
        "noReactSpecificProps": "off"
      }
    }
  }
}
